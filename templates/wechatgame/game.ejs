console.warn('[WebGPU][boot-v3] game.js evaluated');
GameGlobal.__webgpuBootTrace = { stage: 'game-evaluated', events: [] };
function __traceWebGPUBoot(stage) {
    const trace = GameGlobal.__webgpuBootTrace;
    trace.stage = stage;
    trace.events.push({ stage: stage, time: Date.now() });
    console.warn('[WebGPU][boot-v3] ' + stage);
}
function __initApp () {  // init app
__traceWebGPUBoot('initApp-enter');
globalThis.__wxRequire = require;  // FIX: require cannot work in separate engine 
// Engine WebGPU template v1
var window = GameGlobal;
const webgpuEnabled = <%= typeof useWebGPU !== 'undefined' && useWebGPU ? 'true' : 'false' %>; // ENGINE_WEBGPU_BUILD_FLAG
GameGlobal.__cocosWebGPUEnabled = webgpuEnabled;
let firstScreen;
if (webgpuEnabled) {
<%- include('../../scripts/wechat-webgpu/wechat-webgpu-bootstrap.js').replace('const firstScreen =', 'firstScreen =') %>
} else {
    require('./web-adapter');
    firstScreen = require('./first-screen');
}

<%- include(cocosTemplate, {}) %>

// Adapt for IOS, swap if opposite
const info = wx.getSystemInfoSync();
if (canvas){
    var _w = canvas.width;
    var _h = canvas.height;
    if (info.screenWidth < info.screenHeight) {
        if (canvas.width > canvas.height) {
            _w = canvas.height;
            _h = canvas.width;
        }
    } else {
        if (canvas.width < canvas.height) {
            _w = canvas.height;
            _h = canvas.width;
        }
    }
    canvas.width = _w;
    canvas.height = _h;
}
// Adjust initial canvas size
if (canvas && window.devicePixelRatio >= 2) {canvas.width *= info.devicePixelRatio; canvas.height *= info.devicePixelRatio;}

const importMap = require("<%= importMapFile%>").default;
System.warmup({
    importMap,
    importMapUrl: '<%= importMapFile%>',
    defaultHandler: (urlNoSchema) => {
        require('.' + urlNoSchema);
    },
    handlers: {
        'plugin:': (urlNoSchema) => {
            requirePlugin(urlNoSchema);
        },
        'project:': (urlNoSchema) => {
            require(urlNoSchema);
        },
    },
});

firstScreen.start('<%= alpha %>', '<%= antialias %>', '<%= useWebgl2 %>').then(() => {
    return System.import('<%= applicationJs %>');
}).then((module) => {
    return firstScreen.setProgress(0.2).then(() => Promise.resolve(module));
}).then(({ Application }) => {
    return new Application();
}).then((application) => {
    return firstScreen.setProgress(0.4).then(() => Promise.resolve(application));
}).then((application) => {
    return onApplicationCreated(application);
}).catch((err) => {
    console.error(err);
});

function onApplicationCreated(application) {
    return System.import('cc').then((module) => {
        return firstScreen.setProgress(0.6).then(() => Promise.resolve(module));
    }).then((cc) => {
        require('./engine-adapter');
        return application.init(cc);
    }).then(() => {
        return firstScreen.end().then(() => application.start());
    });
}

}  // init app

// NOTE: on WeChat Android end, we can only get the correct screen size at the second tick of game.
__traceWebGPUBoot('system-info-begin');
var sysInfo = wx.getSystemInfoSync();
__traceWebGPUBoot('system-info-end:' + sysInfo.platform);
if (sysInfo.platform.toLocaleLowerCase() === 'android') {
    __traceWebGPUBoot('raf-schedule');
    GameGlobal.requestAnimationFrame(function () {
        __traceWebGPUBoot('raf-fired');
        __initApp();
    });
    __traceWebGPUBoot('raf-scheduled');
} else {
    __initApp();
}
